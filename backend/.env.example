# Explicitly opt into local identity; never enable it in production.
NODE_ENV=development
DEV_LOGIN_ENABLED=true
DEV_ADMIN_EMAIL=admin@example.test
DEV_ADMIN_PASSWORD=local-development-password
# Replace this development-only secret with a unique random value.
SESSION_SECRET=development-only-secret-change-this-32bytes
DATABASE_PATH=./data/eqip.sqlite
PORT=3000
# Optional direct browser access; same-origin proxy does not need CORS.
CORS_ORIGIN=http://localhost:5173
